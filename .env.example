# ─────────────────────────────────────────────────────────────
# KYVON OS — variáveis de ambiente
# Copie para `.env.local` e ajuste. NUNCA comite o .env real.
# ─────────────────────────────────────────────────────────────

# Ambiente: development | test | production
NODE_ENV=development

# ── Banco de dados ───────────────────────────────────────────
# Deixe vazio para o Postgres embarcado de dev (PGlite).
#
# Supabase (Project Settings → Database → Connection string):
#   DATABASE_URL           → pooler em modo transação (porta 6543), usado pela app
#   DATABASE_MIGRATION_URL → conexão direta ou pooler em modo sessão (porta 5432),
#                            usado só por `npm run db:migrate`
# Sempre com ?sslmode=require. Exemplo:
#   DATABASE_URL=postgresql://postgres.<ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:6543/postgres?sslmode=require
#   DATABASE_MIGRATION_URL=postgresql://postgres.<ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=
DATABASE_MIGRATION_URL=

# Diretório de dados do Postgres embarcado (apenas dev/test)
PGLITE_DATA_DIR=.data/pglite

# ── Sessão / autenticação ────────────────────────────────────
# Segredo usado para derivar o hash dos tokens de sessão.
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=troque-este-valor-em-producao-com-no-minimo-32-caracteres

# Duração da sessão em dias
SESSION_TTL_DAYS=7

# ── Storage de arquivos ──────────────────────────────────────
# local | supabase
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=storage/uploads
STORAGE_MAX_FILE_SIZE_MB=25

# Somente quando STORAGE_DRIVER=supabase. O bucket deve ser PRIVADO
# (crie com `npm run storage:setup`). A service role key ignora RLS:
# é segredo de servidor, nunca use prefixo NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=kyvon-files

# ── Aplicação ────────────────────────────────────────────────
APP_URL=http://localhost:3000
APP_TIMEZONE=America/Sao_Paulo

# Permite rodar o seed de demonstração. Bloqueado em produção.
ALLOW_DEMO_SEED=true
